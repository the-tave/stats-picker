@article{ofemofemetal2022,
  title = {Development, {{Validation}} and {{Standardization}} of {{Instrument}} to {{Measure Statistical Literacy}} among {{Universities Undergraduates}} in {{Cross River State}}},
  author = {Ofem, Usani Joseph and Ofem, Isaac Ubi and Akpan, Samuel and Ovat, Sylvia Victor and Nworgwugwu, C. E. and Otu, Bernard and Atah, Cletus Akpo},
